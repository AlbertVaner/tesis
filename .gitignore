# Entornos virtuales
.venv/

# Secretos y entorno local (ver .env.example)
.env
.env.*
!.env.example
venv/
env/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.dll

# Caches
.cache/
cache/
cache_*/
.pytest_cache/

# Logs y datos generados
*.log
*.csv
results/data/
# Videos de la interfaz (--grabar-video): pesan decenas de MB
results/captures/**/*.mp4
# Grabaciones HD por cámara (--grabar-hd) y sus registros: varios GB por sesión
results/captures/**/*.mkv
results/captures/**/*.jsonl
results/captures/**/*.npz
# Exportaciones de documentos (Word/PDF de la tesis): van al OneDrive, no al código
output/
resultado_propeller_test.txt

# Archivos temporales y renders de presentaciones
tmp/
results/artifacts/*.inspect.ndjson
results/artifacts/presentacion_avances_albert_vandercam/

# VS Code
.vscode/

# Sistema
Thumbs.db
.DS_Store

# Comprimidos
*.zip

# Obsidian: estado de ventanas y cachés locales, no versionar
Tesis/.obsidian/workspace.json
Tesis/.obsidian/workspace-mobile.json
Tesis/.obsidian/cache

# graphify: sidecars temporales
graphify-out/.graphify_*
# graphify: copias diarias del grafo (~6 MB cada una); sólo se versiona la vigente
graphify-out/20*/
