# Copiar a `.env` en la raiz y rellenar. `.env` NO se versiona.
# Lo lee external/gesture_detection/camara_env.py cuando un lanzador recibe
# `--rtsp env`. Las variables del entorno real mandan sobre este archivo.

# Camara IP Amcrest del laboratorio. La IP cambia por DHCP: si deja de
# responder, buscarla por los puertos abiertos 80 + 554 + 37777.
CAM_HOST=
CAM_USER=admin
CAM_PASSWORD=

# Mas camaras: CAM2_HOST ... CAM6_HOST. Las usan `--multicamara`,
# probar_multicamara.py y el panel web (cam2, cam3...), y cualquier lanzador
# con `--rtsp cam2`, `--rtsp cam3`... (`--rtsp env` es cam1). Usuario, clave,
# puerto y sub-stream salen de CAMN_USER, CAMN_PASSWORD... y, si no estan, de
# los CAM_* de arriba. En el laboratorio son tres IP4M-1041B en el techo.
# CAM2_HOST=
# CAM3_HOST=

# 1 = sub-stream (recomendado: menos latencia). 0 = stream principal.
CAM_SUBTYPE=1

# "Mirar al frente": donde va la camara antes de buscar a la persona.
# Montada de lado, el frente es pan 180 (pan 0 mira hacia atras y boca abajo).
# El tilt es el barrido horizontal (-4 a 79): tras orientar el soporte con el
# tilt a mitad de recorrido, poner aqui 37.
# OJO: la lectura de pan 180 es el TOPE mecanico del pan (fisico = 180 - leido) y
# el centro de su recorrido es la lectura ~3. El frente no debe caer sobre el
# tope: se define a ojo con `seguir_persona.py --rtsp env --guardar-frente`.
CAM_FRENTE_PAN=180
CAM_FRENTE_TILT=0
